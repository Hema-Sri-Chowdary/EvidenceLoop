# EvidenceLoop Backend Environment Configuration
# ---------------------------------------------------------
# Server Port (Render sets this automatically; defaults to 5000 locally)
PORT=5000

# Environment Mode ('development' or 'production')
NODE_ENV=production

# JWT Authentication Secret Key (Replace with a secure 32+ character key)
JWT_SECRET=evidenceloop_secure_production_jwt_secret_token_key_2026

# Allowed Frontend Origins for CORS (comma-separated list)
# Include your Vercel deployment URL (or custom domain) and local dev URL
CLIENT_ORIGIN=https://your-frontend-app.vercel.app,http://localhost:5173

# Database Connection (Optional)
# If provided, EvidenceLoop connects to MongoDB Atlas.
# If omitted or offline, EvidenceLoop automatically persists data to server/data/*.json
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/evidenceloop?retryWrites=true&w=majority

# Real-Time Multi-Factor Authentication (MFA) Email Dispatch (Optional)
# If configured, EvidenceLoop automatically dispatches real 6-digit MFA OTPs
# directly to the user's inbox in real time!
# If left empty, OTPs are output in real time to the server logs and live test banner.
#
# Option A: Gmail (Use a Google Account App Password)
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
#
# Option B: Standard SMTP Server (SendGrid, Mailgun, Amazon SES, Brevo)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# EMAIL_FROM="EvidenceLoop Security" <security@evidenceloop.com>
