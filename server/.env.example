# EvidenceLoop Backend Environment Configuration
# ---------------------------------------------------------
# Server Port (Render sets this automatically; defaults to 5000 locally)
PORT=5000

# Environment Mode ('development' or 'production')
NODE_ENV=production

# JWT Authentication Secret Key
# Generate a secure 32+ character key for signing authentication tokens
JWT_SECRET=evidenceloop_secure_production_jwt_secret_token_key_2026

# Allowed Frontend Origins for CORS (comma-separated list)
# Include your Vercel deployment URL (or custom domain) and local dev URL
CLIENT_ORIGIN=https://your-frontend-app.vercel.app,http://localhost:5173

# Database Connection (Optional)
# If provided, EvidenceLoop connects to MongoDB Atlas.
# If omitted or offline, EvidenceLoop automatically persists data to server/data/*.json
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/evidenceloop?retryWrites=true&w=majority
